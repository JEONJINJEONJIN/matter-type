{
  "name": "matter-type",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests README.md vite.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.2.0",
    "@mapbox/tiny-sdf": "^2.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
